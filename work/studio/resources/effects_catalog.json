{
  "version": "4.0",
  "visualEffects": [
    {
      "id": "rgb_split",
      "name": "色散分離",
      "category": "光學畸變",
      "keywords": ["rgb", "chromatic", "aberration", "色散", "色差", "分色", "抖音", "光學"],
      "description": "紅藍通道水平與垂直錯位，營造鏡頭色散與潮流視覺衝擊。",
      "ffmpegFilter": "format=rgba,rgbashift=rh=-8:bv=6:bh=8"
    },
    {
      "id": "vhs_scan",
      "name": "VHS 掃描線",
      "category": "復古膠片",
      "keywords": ["vhs", "crt", "scanline", "retro", "錄影帶", "掃描線", "復古", "電視"],
      "description": "經典類比錄影帶雜訊、偏暖褪色與交錯深色掃描線。",
      "ffmpegFilter": "format=rgb24,noise=alls=14:allf=t+u,eq=contrast=1.08:saturation=0.82,colorbalance=rs=0.05:bs=-0.04,geq=r='if(mod(Y,4),r(X,Y),r(X,Y)*0.72)':g='if(mod(Y,4),g(X,Y),g(X,Y)*0.72)':b='if(mod(Y,4),b(X,Y),b(X,Y)*0.75)'"
    },
    {
      "id": "glitch_shift",
      "name": "數位故障",
      "category": "光學畸變",
      "keywords": ["glitch", "cyber", "tear", "故障", "撕裂", "訊號干擾", "失真", "賽博"],
      "description": "動態水平掃描帶錯位與紅藍分離，模擬數位訊號故障撕裂感。",
      "ffmpegFilter": "format=rgb24,geq=r='r(mod(X+if(lt(mod(Y+floor(N*17),64),8),14,0),W),Y)':g='g(X,Y)':b='b(mod(X-if(lt(mod(Y+floor(N*23),52),6),12,0),W),Y)'"
    },
    {
      "id": "pixelate",
      "name": "像素馬賽克",
      "category": "藝術風格",
      "keywords": ["pixel", "mosaic", "8bit", "retro", "像素", "馬賽克", "點陣", "復古遊戲"],
      "description": "最近鄰降採樣再放大，產生銳利方格像素化馬賽克效果。",
      "ffmpegFilter": "scale=max(2\\,trunc(iw/10)):max(2\\,trunc(ih/10)):flags=neighbor,scale={W}:{H}:flags=neighbor"
    },
    {
      "id": "sharpen_detail",
      "name": "銳利細節",
      "category": "光學畸變",
      "keywords": ["sharpen", "crisp", "detail", "unsharp", "銳化", "清晰", "細節", "質感"],
      "description": "使用非銳化遮罩強化畫面微對比與邊緣輪廓清晰度。",
      "ffmpegFilter": "unsharp=5:5:1.5:5:5:0.4"
    },
    {
      "id": "edge_glow",
      "name": "霓虹邊緣",
      "category": "藝術風格",
      "keywords": ["neon", "edge", "outline", "glow", "霓虹", "邊緣", "發光", "線稿"],
      "description": "偵測高反差影像輪廓並融合飽和霓虹色彩邊線。",
      "ffmpegFilter": "edgedetect=low=0.08:high=0.28:mode=colormix,eq=saturation=1.8:contrast=1.25"
    },
    {
      "id": "posterize",
      "name": "海報色階",
      "category": "藝術風格",
      "keywords": ["poster", "comic", "quantize", "海報", "色階", "漫畫", "普普", "色塊"],
      "description": "將 RGB 亮度階數離散化，呈現鮮明平面海報色塊質感。",
      "ffmpegFilter": "format=rgb24,lutrgb=r='trunc(val/48)*48':g='trunc(val/48)*48':b='trunc(val/48)*48'"
    },
    {
      "id": "mirror_split",
      "name": "左右鏡像分屏",
      "category": "動感與鏡像",
      "keywords": ["mirror", "split", "symmetry", "鏡像", "對稱", "分屏", "左右翻轉"],
      "description": "裁切左半畫面並水平翻轉拼接至右半，建立完美左右對稱構圖。",
      "ffmpegFilter": "split[{p}_a][{p}_b];[{p}_a]crop=trunc(iw/2):ih:0:0[{p}_l];[{p}_b]crop=trunc(iw/2):ih:0:0,hflip[{p}_r];[{p}_l][{p}_r]hstack=inputs=2"
    },
    {
      "id": "film_grain",
      "name": "底片顆粒",
      "category": "復古膠片",
      "keywords": ["film", "grain", "35mm", "analog", "底片", "顆粒", "膠片", "雜訊"],
      "description": "加入動態有機 35mm 膠片顆粒並微調對比與飽和度。",
      "ffmpegFilter": "noise=alls=18:allf=t+u,eq=contrast=1.06:saturation=0.92"
    },
    {
      "id": "cinematic_teal_orange",
      "name": "青橙電影",
      "category": "調色風格",
      "keywords": ["teal", "orange", "cinema", "movie", "青橙", "電影", "好萊塢", "調色"],
      "description": "暗部注入冷青色調、亮部拉升暖橘膚色，經典院線電影色調。",
      "ffmpegFilter": "colorbalance=rs=-0.12:gs=0.04:bs=0.14:rm=0.04:gm=-0.02:bm=-0.06:rh=0.16:gh=0.05:bh=-0.14,eq=contrast=1.10:saturation=1.12"
    },
    {
      "id": "matte_fade",
      "name": "霧面褪色",
      "category": "調色風格",
      "keywords": ["matte", "fade", "lifted", "soft", "霧面", "褪色", "日系", "低反差"],
      "description": "拉高黑位並壓低純白頂點，呈現柔和日系霧面膠片氛圍。",
      "ffmpegFilter": "curves=all='0/0.11 0.25/0.28 0.75/0.77 1/0.91',eq=saturation=0.86"
    },
    {
      "id": "noir_cinema",
      "name": "黑色電影",
      "category": "復古膠片",
      "keywords": ["noir", "bw", "monochrome", "contrast", "黑色電影", "黑白", "高對比", "經典"],
      "description": "高反差 S 曲線單色黑白搭配深暗角，再現經典黑色電影光影。",
      "ffmpegFilter": "hue=s=0,curves=all='0/0 0.2/0.09 0.5/0.5 0.8/0.91 1/1',vignette=PI/4"
    },
    {
      "id": "sepia_warm",
      "name": "懷舊褐調",
      "category": "復古膠片",
      "keywords": ["sepia", "vintage", "old", "brown", "懷舊", "褐調", "老照片", "復古"],
      "description": "經典 RGB 色彩矩陣轉換為溫暖泛黃棕褐懷舊色調。",
      "ffmpegFilter": "colorchannelmixer=.393:.769:.189:0:.349:.686:.168:0:.272:.534:.131:0,eq=contrast=1.04"
    },
    {
      "id": "negative",
      "name": "負片反色",
      "category": "藝術風格",
      "keywords": ["negative", "invert", "xray", "負片", "反色", "底片反轉", "前衛"],
      "description": "反轉全畫面 RGB 色彩與明暗階調，呈現強烈負片視覺。",
      "ffmpegFilter": "negate"
    },
    {
      "id": "thermal",
      "name": "熱像偽彩",
      "category": "藝術風格",
      "keywords": ["thermal", "heat", "infrared", "predator", "熱像", "紅外線", "偽彩", "熱感應"],
      "description": "依影像亮度映射熱感應偽彩光譜（藍紫低溫至紅黃白高溫）。",
      "ffmpegFilter": "format=yuv420p,pseudocolor=preset=heat"
    },
    {
      "id": "emboss",
      "name": "浮雕立體",
      "category": "藝術風格",
      "keywords": ["emboss", "relief", "sculpt", "3d", "浮雕", "立體", "雕刻", "紋理"],
      "description": "透過 3×3 方向卷積核心與中性灰偏壓刻畫立體浮雕紋理。",
      "ffmpegFilter": "format=gbrp,convolution=0m='-2 -1 0 -1 1 1 0 1 2':1m='-2 -1 0 -1 1 1 0 1 2':2m='-2 -1 0 -1 1 1 0 1 2':0bias=128:1bias=128:2bias=128"
    },
    {
      "id": "bloom_soft",
      "name": "柔光漫射",
      "category": "光學畸變",
      "keywords": ["bloom", "glow", "halation", "dream", "柔光", "漫射", "光暈", "黑柔鏡"],
      "description": "將高光模糊層以濾色模式疊加回原畫面，模擬黑柔濾鏡光暈。",
      "ffmpegFilter": "format=rgb24,split[{p}_b0][{p}_b1];[{p}_b1]gblur=sigma=12,eq=brightness=0.08:contrast=1.2[{p}_b2];[{p}_b0][{p}_b2]blend=all_mode=screen:all_opacity=0.45"
    },
    {
      "id": "kaleido",
      "name": "四象限萬花筒",
      "category": "動感與鏡像",
      "keywords": ["kaleidoscope", "quad", "mirror", "trippy", "萬花筒", "四象限", "對稱", "迷幻"],
      "description": "取左上象限向水平、垂直與對角鏡像複製，構成四向對稱萬花筒。",
      "ffmpegFilter": "split=4[{p}_k1][{p}_k2][{p}_k3][{p}_k4];[{p}_k1]crop=trunc(iw/2):trunc(ih/2):0:0[{p}_tl];[{p}_k2]crop=trunc(iw/2):trunc(ih/2):0:0,hflip[{p}_tr];[{p}_k3]crop=trunc(iw/2):trunc(ih/2):0:0,vflip[{p}_bl];[{p}_k4]crop=trunc(iw/2):trunc(ih/2):0:0,hflip,vflip[{p}_br];[{p}_tl][{p}_tr]hstack[{p}_top];[{p}_bl][{p}_br]hstack[{p}_bot];[{p}_top][{p}_bot]vstack"
    },
    {
      "id": "vignette_heavy",
      "name": "深邃暗角",
      "category": "光學畸變",
      "keywords": ["vignette", "dark", "spotlight", "focus", "暗角", "聚光", "壓暗", "電影感"],
      "description": "強烈大角度四周暗角壓暗，將觀眾視線牢牢鎖定於畫面中央。",
      "ffmpegFilter": "vignette=angle=PI/2.2:mode=forward,eq=contrast=1.08:brightness=-0.03"
    },
    {
      "id": "bw_grain",
      "name": "黑白顆粒",
      "category": "復古膠片",
      "keywords": ["bw", "grain", "tri-x", "documentary", "黑白", "顆粒", "紀實", "銀鹽"],
      "description": "紀實銀鹽黑白影調搭配強烈動態底片顆粒感。",
      "ffmpegFilter": "hue=s=0,noise=alls=22:allf=t+u,eq=contrast=1.18"
    },
    {
      "id": "dreamy_haze",
      "name": "夢幻薄霧",
      "category": "光學畸變",
      "keywords": ["dreamy", "haze", "pastel", "mist", "夢幻", "薄霧", "柔霧", "仙氣"],
      "description": "柔焦變亮混合層結合粉紫高光偏移，打造唯美夢幻薄霧質感。",
      "ffmpegFilter": "format=rgb24,split[{p}_d0][{p}_d1];[{p}_d1]gblur=sigma=8,eq=brightness=0.10:saturation=1.2[{p}_d2];[{p}_d0][{p}_d2]blend=all_mode=lighten:all_opacity=0.38,colorbalance=rh=0.06:bh=0.08"
    },
    {
      "id": "duotone_cyber",
      "name": "賽博雙色調",
      "category": "調色風格",
